{
  "name": "soroban-pay-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --max-warnings 0",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --coverageReporters=lcov",
    "test:pact": "jest tests/pact/api.consumer.pact.test.ts --verbose",
    "type-check": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings 0 --fix",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@react-pdf/renderer": "4.3.0",
    "@stellar/freighter-api": "^3.0.0",
    "@stellar/stellar-sdk": "^12.3.0",
    "framer-motion": "^11.18.2",
    "next": "14.2.5",
    "next-intl": "^3.17.2",
    "next-pwa": "5.6.0",
    "qrcode.react": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hotkeys-hook": "4.5.1"
  },
  "devDependencies": {
    "@pact-foundation/pact": "^12.5.0",
    "@playwright/test": "^1.44.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "husky": "^9.1.4",
    "identity-obj-proxy": "^3.0.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.2.8",
    "msw": "^2.15.0",
    "postcss": "^8.4.40",
    "storybook": "8.1.11",
    "tailwindcss": "^3.4.7",
    "ts-jest": "29.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
