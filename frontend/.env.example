# Deployed SorobanPay contract address (output of deploy/deploy.sh)
NEXT_PUBLIC_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Target network: "testnet" (default) or "mainnet"
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# The RPC URL and network passphrase below are optional overrides.
# When NEXT_PUBLIC_STELLAR_NETWORK is set, getNetworkConfig() uses the
# built-in presets automatically. Only set these if you need to point
# to a custom RPC endpoint.
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
