# SorobanPay frontend environment variables
# Copy this file to .env.local and fill in the values for your target network.
#
# ── Quickstart ────────────────────────────────────────────────────────────────
#
# For testnet (default):
#   1. Set NEXT_PUBLIC_CONTRACT_ID to your deployed contract address.
#   2. Leave everything else at the defaults below.
#
# For mainnet:
#   1. Set NEXT_PUBLIC_STELLAR_NETWORK=mainnet
#   2. Set NEXT_PUBLIC_CONTRACT_ID to your mainnet contract address.
#   3. Optionally set NEXT_PUBLIC_RPC_URL to your own RPC node.
#   4. NEXT_PUBLIC_NETWORK_PASSPHRASE is set automatically — only override it
#      if you know what you are doing.
#
# ── Typed network selection (issue #32) ───────────────────────────────────────
#
# NEXT_PUBLIC_STELLAR_NETWORK selects the active network profile from the
# typed NETWORK_CONFIGS object in frontend/src/lib/network_config.ts.
# That object is the single source of truth for passphrase and default RPC URL.
#
# Allowed values: "testnet" (default) | "mainnet"
#
# When this variable is set, NEXT_PUBLIC_NETWORK_PASSPHRASE and the default
# NEXT_PUBLIC_RPC_URL are derived automatically — you only need to set them
# if you want to override the defaults from network_config.ts.
#
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# ── Contract address ──────────────────────────────────────────────────────────
#
# Deployed SorobanPay subscription contract address (C…).
# Run `bash deploy/deploy.sh` to deploy and get an address.
#
NEXT_PUBLIC_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── RPC URL (optional override) ───────────────────────────────────────────────
#
# Soroban RPC endpoint. Leave blank to use the default for the active network:
#   testnet → https://soroban-testnet.stellar.org
#   mainnet → https://mainnet.stellar.validationcloud.io/v1/<API_KEY>
#
# Set this to use a custom node (Validation Cloud, Blockdaemon, self-hosted).
#
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org

# ── Network passphrase (optional override) ────────────────────────────────────
#
# Derived automatically from NEXT_PUBLIC_STELLAR_NETWORK.
# Only set this manually if you are connecting to a custom/local network that
# is not in network_config.ts.
#
# testnet: Test SDF Network ; September 2015
# mainnet: Public Global Stellar Network ; September 2015
#
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
