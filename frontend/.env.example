# SorobanPay frontend environment variables
# Copy this file to .env.local and fill in the values for your target network.
#
# For testnet vs. mainnet values and common configuration mistakes, see:
#   docs/networks.md
#
# Testnet values (default):
#   NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
#   NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
#
# Mainnet values:
#   NEXT_PUBLIC_RPC_URL=https://mainnet.stellar.validationcloud.io/v1/<API_KEY>
#   NEXT_PUBLIC_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015

NEXT_PUBLIC_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
