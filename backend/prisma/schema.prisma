// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id              Int      @id @default(autoincrement())
  type            String   // "subscribe", "executed", "payment_transfer_failure", "cancel"
  subscriber      String
  merchant        String
  token           String
  amount          String   // Store as string to handle big integers
  ledgerTimestamp BigInt
  createdAt       DateTime @default(now())
}

model AuditLog {
  id               Int      @id @default(autoincrement())
  eventType        String
  subscriber       String
  merchant         String
  token            String
  amount           String
  transactionHash  String   @unique
  ledger           BigInt
  status           String   @default("executed")
  createdAt        DateTime @default(now())
}

model PayoutSummary {
  id           Int      @id @default(autoincrement())
  merchant     String
  startDate    DateTime
  endDate      DateTime
  totalAmount  String   // Total amount for the period
  paymentCount Int      // Number of payments
  currency     String   // Token address
  createdAt    DateTime @default(now())
  type         String   // "daily" or "weekly"
}

model WebhookEndpoint {
  id        Int      @id @default(autoincrement())
  merchant  String
  url       String
  active    Boolean  @default(true)
  secret    String?  // HMAC-SHA256 signing secret; null = unsigned
  createdAt DateTime @default(now())

  deliveries WebhookDelivery[]

  @@unique([merchant, url])
}

model WebhookDelivery {
  id          Int      @id @default(autoincrement())
  /// Stable event identifier — sha256(txHash + eventIndex).
  /// Constant across all retry attempts for the same event.
  /// Merchants use this as their idempotency key.
  eventId     String
  /// UUID v4 unique per delivery attempt (changes on every retry).
  deliveryId  String   @unique @default(uuid())
  url         String
  merchant    String
  event       String
  payload     String
  statusCode  Int
  attempt     Int
  success     Boolean
  error       String?
  createdAt   DateTime @default(now())

  endpointId  Int?
  endpoint    WebhookEndpoint? @relation(fields: [endpointId], references: [id])

  @@index([eventId])
  @@index([merchant, createdAt])
  @@index([merchant, success, createdAt])
}

// BE-67: Subscription lifecycle state machine persistence
model Subscription {
  id         Int      @id @default(autoincrement())
  subscriber String
  merchant   String
  token      String   @default("")
  status     String   @default("ACTIVE") // ACTIVE | PAUSED | OVERDUE | CANCELLED | EXPIRED
  amount     String   @default("0")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([subscriber, merchant], name: "subscriber_merchant")
}

// BE-68: Email notification preferences
model NotificationPreference {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  subscriber   String?
  merchant     String?
  unsubToken   String   @unique @default(cuid())
  emailEnabled Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// #790: Persistent retry tracking for failed execute_payment attempts.
// Merged from both duplicate PaymentRetry blocks; keeps the superset of all fields.
model PaymentRetry {
  id            Int      @id @default(autoincrement())
  subscriber    String
  merchant      String
  /// Number of retry attempts made so far (0 = not yet retried)
  attempts      Int      @default(0)
  /// Most recent error message from the last failed attempt
  lastError     String?
  /// Unix timestamp (seconds) of the next scheduled retry
  nextRetryAt   BigInt?
  /// Idempotency key — sha256(subscriber + merchant + ledger) — prevents duplicate submissions
  idempotencyKey String  @unique
  /// Current retry state: PENDING | IN_FLIGHT | SUCCEEDED | EXHAUSTED
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, nextRetryAt])
  @@index([subscriber, merchant])
}
