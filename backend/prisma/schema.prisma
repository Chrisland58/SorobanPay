// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id              Int      @id @default(autoincrement())
  type            String   // "subscribe", "executed", "payment_transfer_failure", "cancel"
  subscriber      String
  merchant        String
  token           String
  amount          String   // Store as string to handle big integers
  ledgerTimestamp BigInt
  createdAt       DateTime @default(now())
}

model AuditLog {
  id               Int      @id @default(autoincrement())
  eventType        String
  subscriber       String
  merchant         String
  token            String
  amount           String
  transactionHash  String   @unique
  ledger           BigInt
  status           String   @default("executed")
  createdAt        DateTime @default(now())
}

model PayoutSummary {
  id           Int      @id @default(autoincrement())
  merchant     String
  startDate    DateTime
  endDate      DateTime
  totalAmount  String   // Total amount for the period
  paymentCount Int      // Number of payments
  currency     String   // Token address
  createdAt    DateTime @default(now())
  type         String   // "daily" or "weekly"
}

model WebhookEndpoint {
  id        Int      @id @default(autoincrement())
  merchant  String
  url       String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([merchant, url])
}

model WebhookDelivery {
  id         Int      @id @default(autoincrement())
  url        String
  merchant   String
  event      String
  payload    String
  statusCode Int
  attempt    Int
  success    Boolean
  error      String?
  createdAt  DateTime @default(now())
}

// BE-67: Subscription lifecycle state machine persistence
model Subscription {
  id         Int      @id @default(autoincrement())
  subscriber String
  merchant   String
  token      String   @default("")
  status     String   @default("ACTIVE") // ACTIVE | PAUSED | OVERDUE | CANCELLED | EXPIRED
  amount     String   @default("0")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([subscriber, merchant], name: "subscriber_merchant")
}

// BE-68: Email notification preferences
model NotificationPreference {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  subscriber   String?
  merchant     String?
  unsubToken   String   @unique @default(cuid())
  emailEnabled Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// BE-70: Payment retry tracking — merged from two draft blocks (#754)
// attemptedAt: when the retry was scheduled/attempted
// executedAt:  when the retry successfully executed (null until confirmed)
model PaymentRetry {
  id           Int       @id @default(autoincrement())
  subscriber   String
  merchant     String
  token        String
  amount       String
  attempt      Int       @default(1)
  status       String    @default("pending") // pending | success | failed
  attemptedAt  DateTime?
  executedAt   DateTime?
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([subscriber, merchant])
  @@index([status, attemptedAt])
}
