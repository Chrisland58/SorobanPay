// SorobanPay Prisma schema — canonical definition (#1379)
//
// Five core tables required by the issue:
//   1. Subscription       — on-chain subscription state mirror
//   2. Payment            — normalised executed/failed payment records
//   3. IndexerState       — singleton RPC cursor for resumable indexing
//   4. WebhookEndpoint    — merchant-registered webhook endpoints
//   5. WebhookDelivery    — per-attempt delivery records for audit and retry
//
// Supporting models retained from the previous schema:
//   Event, AuditLog, PayoutSummary, PaymentRetry, RetryConfig,
//   NotificationPreference, OutboxEvent
//
// All duplicate model definitions (multiple PaymentRetry, multiple IndexerState)
// from the previous schema have been consolidated into a single authoritative
// definition per model.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── 1. Raw contract events ───────────────────────────────────────────────────
// Written by the event indexer; source of truth for all on-chain activity.

model Event {
  id              Int      @id @default(autoincrement())
  type            String   // "subscribe" | "executed" | "payment_transfer_failure" | "cancel"
  subscriber      String
  merchant        String
  token           String
  amount          String   // stored as string to safely hold i128 values
  ledgerTimestamp BigInt
  createdAt       DateTime @default(now())

  @@index([merchant])
  @@index([subscriber, merchant])
  @@index([type, merchant])
  @@index([ledgerTimestamp])
}

// ─── 2. Subscriptions ────────────────────────────────────────────────────────
// Mirrors on-chain SubscriptionData; kept in sync by the event indexer.

model Subscription {
  id           Int       @id @default(autoincrement())
  subscriber   String
  merchant     String
  token        String    @default("")
  amount       String    @default("0")   // stroops as string (i128)
  interval     BigInt    @default(0)     // seconds between payments (u64)
  nextPayment  BigInt    @default(0)     // Unix timestamp of next due payment
  status       String    @default("ACTIVE") // ACTIVE | PAUSED | OVERDUE | CANCELLED | EXPIRED
  overdueSince DateTime?                 // set when payment is missed; cleared on success
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([subscriber, merchant, token], name: "subscriber_merchant_token")
  @@index([merchant])
  @@index([subscriber])
  @@index([status])
  @@index([merchant, status])
  @@index([nextPayment])
}

// ─── 3. Payments ─────────────────────────────────────────────────────────────
// Normalised record for every executed or failed payment.

model Payment {
  id           Int      @id @default(autoincrement())
  subscriber   String
  merchant     String
  token        String
  amount       String   // stroops as string
  eventType    String   @default("executed") // executed | failed
  txHash       String   @unique
  paymentNonce Int      @default(0)          // on-chain payment_nonce (u32)
  timestamp    DateTime
  createdAt    DateTime @default(now())

  @@index([merchant])
  @@index([subscriber])
  @@index([merchant, timestamp])
  @@index([subscriber, merchant])
  @@index([timestamp])
}

// ─── 4. Indexer state ────────────────────────────────────────────────────────
// Singleton row (id = 1) tracking the RPC cursor for resumable indexing.

model IndexerState {
  id                Int      @id @default(1)
  cursor            String?  // opaque cursor from getEvents(); null = start from genesis
  lastIndexedLedger Int      @default(0)
  updatedAt         DateTime @updatedAt
}

// ─── 5. Webhooks ─────────────────────────────────────────────────────────────
// Merchant-registered webhook endpoints (created via POST /webhook-registrations).

model WebhookEndpoint {
  id        Int      @id @default(autoincrement())
  merchant  String
  url       String
  active    Boolean  @default(true)
  secret    String?  // HMAC-SHA256 signing secret; null = unsigned
  /// Comma-separated event types, e.g. "payment.executed,payment.failed"
  events    String   @default("payment.executed,payment.failed")
  createdAt DateTime @default(now())

  deliveries WebhookDelivery[]

  @@unique([merchant, url])
  @@index([merchant])
  @@index([active])
}

// ─── 6. Webhook deliveries ───────────────────────────────────────────────────
// Tracks each delivery attempt for audit and retry.

model WebhookDelivery {
  id            Int      @id @default(autoincrement())
  webhookId     Int?
  /// Stable event identifier — sha256(txHash + eventIndex).
  /// Constant across all retry attempts; used as merchant idempotency key.
  eventId       String
  /// UUID v4 unique per delivery attempt (changes on every retry).
  deliveryId    String   @unique @default(uuid())
  url           String
  merchant      String
  event         String
  payload       String
  statusCode    Int      @default(0)
  status        String   @default("pending") // pending | delivered | failed
  attempts      Int      @default(0)
  lastAttemptAt DateTime?
  success       Boolean  @default(false)
  error         String?
  createdAt     DateTime @default(now())

  endpoint WebhookEndpoint? @relation(fields: [webhookId], references: [id])

  @@index([eventId])
  @@index([merchant])
  @@index([merchant, status])
  @@index([merchant, createdAt])
  @@index([webhookId])
}

// ─── Audit logs ───────────────────────────────────────────────────────────────

model AuditLog {
  id              Int      @id @default(autoincrement())
  eventType       String
  subscriber      String
  merchant        String
  token           String
  amount          String
  transactionHash String   @unique
  ledger          BigInt
  status          String   @default("executed")
  createdAt       DateTime @default(now())

  @@index([merchant])
  @@index([subscriber, merchant])
}

// ─── Payout summaries ────────────────────────────────────────────────────────

model PayoutSummary {
  id           Int      @id @default(autoincrement())
  merchant     String
  startDate    DateTime
  endDate      DateTime
  totalAmount  String   // total amount for the period
  paymentCount Int
  currency     String   // token address
  type         String   // "daily" | "weekly"
  createdAt    DateTime @default(now())

  @@index([merchant])
  @@index([merchant, startDate])
}

// ─── Payment retries ─────────────────────────────────────────────────────────
// Tracks automated retry attempts for failed payments.

model PaymentRetry {
  id            Int       @id @default(autoincrement())
  subscriber    String
  merchant      String
  token         String    @default("")
  amount        String    @default("0")
  attemptNumber Int
  scheduledAt   DateTime
  executedAt    DateTime?
  /// PENDING | PROCESSING | SUCCEEDED | FAILED | CANCELLED
  status        String    @default("PENDING")
  errorMessage  String?
  /// BullMQ job ID — used to cancel the queued job on DELETE.
  jobId         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([subscriber, merchant, attemptNumber], name: "subscriber_merchant_attempt")
  @@index([subscriber, merchant])
  @@index([status])
  @@index([status, scheduledAt])
}

// ─── Retry config ────────────────────────────────────────────────────────────

model RetryConfig {
  id            Int      @id @default(autoincrement())
  merchant      String   @unique
  intervalsDays String   // comma-separated, e.g. "1,3,7"
  webhookUrl    String?  // override webhook for max_retries_exceeded events
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Notification preferences ────────────────────────────────────────────────

model NotificationPreference {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  subscriber   String?
  merchant     String?
  unsubToken   String   @unique @default(cuid())
  emailEnabled Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Transactional outbox ─────────────────────────────────────────────────────
// Written atomically with the main Event record; processed asynchronously
// by the OutboxRelay worker.

model OutboxEvent {
  id               Int      @id @default(autoincrement())
  aggregateType    String   // e.g. "subscription"
  aggregateId      String   // e.g. "subscriber:merchant"
  eventType        String   // e.g. "executed", "cancel"
  payload          String   // JSON string of event data
  status           String   @default("pending") // pending | published | failed
  deduplicationKey String   @unique             // RPC event id for idempotency
  createdAt        DateTime @default(now())
  publishedAt      DateTime?

  @@index([status, createdAt])
  @@index([aggregateId])
}

// #1382: Cancellation audit trail
// Records every on-chain cancel event with full context for compliance/audit.
// Retention period configurable via AUDIT_RETENTION_YEARS env var (default: 7).
model CancellationAudit {
  id                String    @id @default(uuid())
  network           String    // "testnet" | "mainnet"
  contractId        String
  subscriberAddress String
  merchantAddress   String
  tokenAddress      String?
  amount            String?   // stroops as string to avoid precision loss
  intervalSeconds   BigInt?
  nextPaymentAt     DateTime?
  cancelledAt       DateTime  @default(now())
  ledger            BigInt
  transactionHash   String
  reason            String?   // max 1000 chars; subscriber/operator-provided
  source            String    @default("event") // "event" | "reconciliation"
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([network, transactionHash], name: "network_tx_hash")
  @@index([merchantAddress, cancelledAt(sort: Desc)])
  @@index([subscriberAddress, cancelledAt(sort: Desc)])
  @@index([network, contractId, subscriberAddress, merchantAddress])
}
