// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id              Int      @id @default(autoincrement())
  type            String   // "subscribe" or "executed"
  subscriber      String
  merchant        String
  token           String
  amount          String   // Store as string to handle big integers
  ledgerTimestamp BigInt
  createdAt       DateTime @default(now())
}

model PayoutSummary {
  id            Int      @id @default(autoincrement())
  merchant      String
  startDate     DateTime
  endDate       DateTime
  totalAmount   String   // Total amount for the period
  paymentCount  Int      // Number of payments
  currency      String   // Token address
  createdAt     DateTime @default(now())
  type          String   // "daily" or "weekly"
}

// Merged from two duplicate PaymentRetry blocks.
// Superset of all fields from both definitions.
model PaymentRetry {
  id           Int      @id @default(autoincrement())
  subscriber   String
  merchant     String
  token        String
  amount       String   // Payment amount in token's smallest unit (stored as string)
  attemptCount Int      @default(0)
  lastAttempt  DateTime?
  nextRetryAt  DateTime?
  status       String   @default("pending") // "pending" | "succeeded" | "failed" | "abandoned"
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([subscriber, merchant])
  @@index([nextRetryAt])
  @@index([status])
}
